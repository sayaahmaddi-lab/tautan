# Salin berkas ini menjadi .env lalu isi nilainya.
#
# Connection string database Neon: konsol Neon > Project > Connection string
# (disarankan memakai endpoint -pooler agar hemat jumlah koneksi).
# Contoh:
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

